#!/bin/sh
# Launch the board with bun when available, else node >= 18.
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
main="$root/board/main.mjs"

if command -v bun >/dev/null 2>&1; then
  exec bun "$main" "$@"
fi
if command -v node >/dev/null 2>&1; then
  major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  if [ "$major" -ge 18 ]; then
    exec node "$main" "$@"
  fi
fi
echo "agents-board: needs bun or node >= 18 on PATH" >&2
printf 'Press Enter to close.' >&2
read -r _ || true
exit 1
